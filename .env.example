VITE_API_BASE_URL=http://localhost:8080

# Only needed if the backend's CORS policy doesn't allow the dev server's origin.
# Leave VITE_API_BASE_URL empty above and set this instead — Vite proxies /api
# requests server-side (see vite.config.ts), so the browser never makes a
# cross-origin request in the first place.
# API_PROXY_TARGET=http://localhost:8080
